# ThrottlePoint configuration. Reference: docs/configuration.md
#
# Setup: set WATTNET_EMAIL and WATTNET_PASSWORD, then
#   chmod 600 /etc/hpc_eff/config.ini
#   hpc-eff            # test run
#   hpc-eff --enable   # install the cron job

[CO2_API]
# Wattnet account (https://api.wattnet.eu/token-request/)
WATTNET_EMAIL=
WATTNET_PASSWORD=

# Throttle above this CO2 intensity (gCO2/kWh, 1 h average)
THRESHOLD=430
# Release the throttle only below THRESHOLD - HYSTERESIS
HYSTERESIS=5

WATTNET_ZONE=CZ
WATTNET_FOOTPRINT_TYPE=carbon
WATTNET_SCOPE=operational
WATTNET_URL=https://api.wattnet.eu/v1/footprints
#WATTNET_TOKEN_CACHE=/var/lib/hpc_eff/wattnet_token.json

# Minutes to keep the last decision if Wattnet is unreachable
MAX_AGE_MIN=120

[frequency_tables]
# CPU max frequency in MHz, highest first.
# First value = full speed, last value = throttled.
amd_epyc=2400,2000,1500
intel_xeon_gold=3000,2900,2800,2700,2600,2200
intel_e5=3000,2800,2700,2600,2400,2300
default=3000,2800,2700,2600,2400,2200

[PIPELINE]
read  = power, cpufreq
score = co2
act   = cpu_freq

[logging]
db_path=/var/lib/hpc_eff/history.db
state_json_path=/var/lib/hpc_eff/state.json
history_length=1000
log_level=INFO

[SYSTEM]
# Power reading for the log only
POWERREADINGCMD=ipmitool dcmi power reading
SCORENAME=SPEC2017
SCORE=3.8
DEBUG=yes
