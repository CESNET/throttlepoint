#!/bin/sh
set -e

# postinst script for hpc-eff
# This script is executed after the package is installed.

case "$1" in
    configure)
        # Cron is NOT enabled here: the shipped config has placeholder API keys,
        # so regulating before the admin configures it would cap the CPU on no
        # data. Upgrades keep an existing /etc/cron.d/hpc-eff untouched.
        echo "hpc-eff installed. Set WATTNET_EMAIL and WATTNET_PASSWORD in"
        echo "/etc/hpc_eff/config.ini (chmod 600), test with 'sudo hpc-eff', then"
        echo "enable cron with 'sudo hpc-eff --enable'."
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
